---
/**
 * Temni odsek (BlockInk namesto čiste črne): oznaka, naslov, uvod in mreža postavk z Lime črto.
 * Postavke podaj kot otroke (RuleItem) ali dodatno vsebino v slot "after".
 */
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Najmanjša širina stolpca mreže (px). */
  minColumn?: 240 | 280;
  /** Razmik mreže: "28px" ali "28px 32px". */
  gridGap?: '28px' | '28px 32px';
  id?: string;
}

const { eyebrow, title, intro, minColumn = 280, gridGap = '28px', id } = Astro.props;
---

<Section tone="dark" gap={40} id={id}>
  <SectionHeading eyebrow={eyebrow} title={title} intro={intro} dark />
  <div class:list={['dk-grid', `dk-min-${minColumn}`, { 'dk-gap-wide': gridGap === '28px 32px' }]}>
    <slot />
  </div>
  <slot name="after" />
</Section>

<style>
  .dk-grid {
    display: grid;
    gap: 28px;
  }
  .dk-min-240 {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .dk-min-280 {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .dk-gap-wide {
    gap: 28px 32px;
  }
</style>
