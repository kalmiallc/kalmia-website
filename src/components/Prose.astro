---
/** Besedilo iz Markdowna (EU projekti, pravna besedila, kasneje blog). */
interface Props {
  lang?: string;
}
const { lang } = Astro.props;
---

<div class="prose" lang={lang}><slot /></div>

<style>
  .prose {
    max-width: 760px;
    font-size: 17px;
    line-height: 1.7;
  }
  .prose :global(> * + *) {
    margin-top: 1em;
  }
  .prose :global(h2) {
    margin-top: 1.8em;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin-top: 1.5em;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.3;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 0.35em;
  }
  .prose :global(a) {
    color: var(--royal);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .prose :global(a:hover) {
    color: var(--ink);
  }
</style>
