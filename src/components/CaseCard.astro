---
/**
 * Kartica reference: oznaka panoge, ime, uvod, izziv, rešitev, rezultat (kazalniki) in oznake.
 * Če ima referenca podstran (href), je kartica klikljiva in ima okroglo ikono s puščico.
 */
import CaseBoxes, { type Kpi } from './CaseBoxes.astro';
import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  name: string;
  tag: string;
  lead: string;
  challenge: string[];
  solution: string[];
  kpis: Kpi[];
  tags: string[];
  href?: string | null;
  headingLevel?: 'h2' | 'h3';
}

const { locale, name, tag, lead, challenge, solution, kpis, tags, href = null, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['case', { 'case--link': href }]}>
  <div class="case-head">
    <div class="case-intro">
      <span class="case-tag">{tag}</span>
      <Heading class="case-name">
        {href ? <a href={href} class="case-link">{name}</a> : name}
      </Heading>
      <p class="case-lead">{lead}</p>
    </div>
    {href && <span class="case-go" aria-hidden="true">→</span>}
  </div>
  <CaseBoxes locale={locale} name={name} challenge={challenge} solution={solution} kpis={kpis} tags={tags} />
</article>

<style>
  .case {
    position: relative;
    background: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .case-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: start;
    justify-content: space-between;
  }
  .case-intro {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .case-tag {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--royal);
  }
  .case-name {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.15;
  }
  .case-link {
    color: inherit;
  }
  /* Celotna kartica je klikljiva prek povezave v naslovu */
  .case-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .case-link:focus-visible {
    outline: none;
  }
  .case-link:focus-visible::after {
    outline: 2px solid var(--royal);
    outline-offset: 2px;
  }
  .case-lead {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .case-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--royal);
    font-size: 16px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .case--link:hover .case-go,
  .case--link:focus-within .case-go {
    background: var(--royal);
    border-color: var(--royal);
    color: var(--paper);
  }
</style>
