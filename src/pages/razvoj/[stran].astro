---
/**
 * Predogled komponent s pravo vsebino iz /content (faza 1 in 2).
 * Zgradi se samo zunaj produkcije (VERCEL_ENV !== "production") in ima noindex.
 * V fazi 3 jo nadomestijo prave strani.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/TileGrid.astro';
import ServiceTile from '@components/ServiceTile.astro';
import ServiceCtaTile from '@components/ServiceCtaTile.astro';
import CaseCard from '@components/CaseCard.astro';
import Faq from '@components/Faq.astro';
import DarkSection from '@components/DarkSection.astro';
import RuleItem from '@components/RuleItem.astro';
import CtaSection from '@components/CtaSection.astro';
import ClientList from '@components/ClientList.astro';
import BookingLink from '@components/BookingLink.astro';
import { VERCEL_ENV } from 'astro:env/server';
import { getCases, getFaq, getPage, getTiles } from '@lib/content';

export function getStaticPaths() {
  if (VERCEL_ENV === 'production') return [];
  return [{ params: { stran: 'komponente' } }];
}

const locale = 'sl';
const services = (await getPage(locale, 'storitve')).data;
const guide = (await getPage(locale, 'vodnik')).data;
const refs = (await getPage(locale, 'reference')).data;
if (services.template !== 'storitve' || guide.template !== 'vodnik' || refs.template !== 'reference') throw new Error('Napačna predloga.');

const groups = await Promise.all(
  services.groups.map(async (g) => ({ ...g, tiles: await getTiles(locale, 'storitve', g.group) }))
);
const faq = await getFaq(locale, services.faq);
const cases = await getCases(locale, 'reference');
---

<BaseLayout
  locale={locale}
  title="Predogled komponent"
  description="Notranja stran za pregled komponent in vsebine. Ni del produkcijske strani."
  breadcrumbs={[{ label: 'Predogled komponent' }]}
  noindex
>
  <Section>
    <h1 class="h1">Predogled komponent</h1>
    <p>Vsebina je iz /content. Stran ni del produkcije; v fazi 3 jo nadomestijo prave strani.</p>
  </Section>

  {
    groups.map((g, i) => (
      <Section id={g.id} tone={i % 2 ? 'surface' : 'white'} borderTop>
        <SectionHeading size="sm" eyebrow={g.eyebrow} title={g.title} />
        <TileGrid>
          {g.tiles.map((t) => (
            <ServiceTile {...t} />
          ))}
          {g.cta && <ServiceCtaTile locale={locale} {...g.cta} />}
        </TileGrid>
      </Section>
    ))
  }

  <DarkSection eyebrow={services.costs.eyebrow} title={services.costs.title}>
    {services.costs.items.map((x) => <RuleItem label={x.label} title={x.title} text={x.text} titleSize={24} />)}
    <div slot="after" class="costs-after">
      <p>{services.costs.note}</p>
      <BookingLink locale={locale} size="md" label={services.costs.button} />
    </div>
  </DarkSection>

  <Faq locale={locale} title={faq.title} items={faq.items} />

  <Section tone="surface" gap={28}>
    {
      cases.map((c) => (
        <CaseCard
          locale={locale}
          name={c.data.title}
          tag={c.data.tag}
          lead={c.data.lead}
          challenge={c.data.izziv}
          solution={c.data.resitev}
          kpis={c.data.kpis}
          tags={c.data.tags}
          href={`/reference/${c.data.slug}`}
        />
      ))
    }
  </Section>

  <Section>
    <ClientList locale={locale} names={refs.clients} variant="stacked" />
  </Section>

  <DarkSection eyebrow={guide.approach.eyebrow} title={guide.approach.title} intro={guide.approach.intro} minColumn={240}>
    {guide.approach.items.map((x) => <RuleItem title={x.title} text={x.text} />)}
  </DarkSection>

  <CtaSection locale={locale} layout={refs.cta.layout} title={refs.cta.title} text={refs.cta.text} />
  <CtaSection locale={locale} borderTop title={guide.cta.title} text={guide.cta.text} />
</BaseLayout>

<style>
  .costs-after {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .costs-after p {
    max-width: 620px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-dark-muted);
  }
</style>
