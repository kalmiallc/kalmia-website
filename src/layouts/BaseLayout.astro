---
/**
 * Osnovna postavitev vseh strani: <head> (title, opis, canonical, Open Graph, hreflang,
 * JSON-LD, pisave), povezava za preskok na vsebino, glava, <main> in noga.
 * Build se ustavi, če stran nima naslova ali opisa.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader, { type Crumb } from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { HTML_LANG, LOCALES, OG_LOCALE, normalizePath, ui, type Locale } from '@lib/i18n';
import { site } from '@lib/site';
import { localeHome, validateContent } from '@lib/content';
import { absoluteUrl, alternatesFor, breadcrumbLd, graph, organizationLd, websiteLd } from '@lib/seo';
import { publicImageSize } from '../plugins/image-size.mjs';
import { VERCEL_ENV } from 'astro:env/server';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Glava in noga: domača stran ali podstran. */
  variant?: 'home' | 'sub';
  breadcrumbs?: Crumb[];
  /** Ime trenutne strani v drobtinicah JSON-LD, če ni zadnja drobtinica. */
  pageName?: string;
  noindex?: boolean;
  /** Ključ za jezikovne različice, npr. "page:storitve" (glej src/lib/seo.ts). */
  translationKey?: string;
  /** Slika za deljenje (pot v /public). Privzeto content/site.json → ogImage. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Dodatni JSON-LD (Service, FAQPage, Article …). Organization, WebSite in BreadcrumbList se dodajo samodejno. */
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  variant = 'sub',
  breadcrumbs = [],
  pageName,
  noindex = false,
  translationKey,
  ogImage = site.ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;
const path = normalizePath(Astro.url.pathname);

if (!title?.trim()) throw new Error(`Stran ${path} nima naslova (title).`);
if (!description?.trim()) throw new Error(`Stran ${path} nima meta opisa (description).`);

await validateContent();

const t = ui(locale);
const canonical = absoluteUrl(path);

// Jezikovne različice: hreflang le, če stran obstaja v vsaj dveh jezikih.
const alternates = translationKey && !noindex ? await alternatesFor(translationKey) : {};
const altLocales = LOCALES.filter((l) => alternates[l]);
const hasAlternates = altLocales.length > 1;
const otherLocale = altLocales.find((l) => l !== locale);
const languageLink = hasAlternates && otherLocale
  ? { href: new URL(alternates[otherLocale]!).pathname, label: t.language.switchTo, code: t.language.code, lang: HTML_LANG[otherLocale] }
  : undefined;

// Slika za deljenje
const ogSize = publicImageSize(ogImage);
if (!ogSize) throw new Error(`Stran ${path}: slika za deljenje ${ogImage} ne obstaja v /public.`);
const ogImageUrl = absoluteUrl(ogImage);

// JSON-LD: podjetje, spletna stran, drobtinice in podatki strani
const crumbItems =
  variant === 'sub'
    ? [
        { name: t.header.home, url: absoluteUrl(await localeHome(locale)) },
        ...breadcrumbs.map((c) => ({ name: c.label, url: c.href ? absoluteUrl(c.href) : canonical })),
        ...(breadcrumbs.at(-1)?.href ? [{ name: pageName ?? title, url: canonical }] : []),
      ]
    : [];
const ld = graph([
  organizationLd(),
  websiteLd(locale),
  ...(crumbItems.length > 1 ? [breadcrumbLd(crumbItems)] : []),
  ...jsonLd,
]);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      hasAlternates && (
        <>
          {altLocales.map((l) => (
            <link rel="alternate" hreflang={HTML_LANG[l]} href={alternates[l]} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates.sl ?? canonical} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kalmia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {hasAlternates && altLocales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {(modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)!.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#ffffff" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <script type="application/ld+json" set:html={ld} />
    {
      /* Vercel Web Analytics: brez piškotkov, z istega izvora. Samo na Vercelu (lokalno ga ni). */
      VERCEL_ENV && <script is:inline defer src="/_vercel/insights/script.js" />
    }
    <slot name="head" />
  </head>
  <body>
    <a href="#vsebina" class="skip-link">{t.skipToContent}</a>
    <SiteHeader locale={locale} variant={variant} breadcrumbs={breadcrumbs} currentPath={path} languageLink={languageLink} />
    <main id="vsebina" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} variant={variant} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
