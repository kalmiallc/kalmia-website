---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TileGrid from '@components/TileGrid.astro';
import ServiceTile from '@components/ServiceTile.astro';
import ServiceCtaTile from '@components/ServiceCtaTile.astro';
import NumberedCards from '@components/NumberedCards.astro';
import StepList from '@components/StepList.astro';
import DarkSection from '@components/DarkSection.astro';
import RuleItem from '@components/RuleItem.astro';
import Faq from '@components/Faq.astro';
import CtaSection from '@components/CtaSection.astro';
import { getFaq, getTiles, pagePath, type PageEntry } from '@lib/content';
import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  entry: PageEntry;
}

const { locale, entry } = Astro.props;
const d = entry.data;
if (d.template !== 'ekipe') throw new Error('Napačna predloga.');
const tiles = await getTiles(locale, d.translationKey, d.forms.group);
const afterLink = await pagePath(locale, d.afterPilot.link.page, d.afterPilot.link.anchor);
const faq = await getFaq(locale, d.faq);
---

<BaseLayout locale={locale} title={d.title} description={d.description} breadcrumbs={[{ label: d.breadcrumb ?? d.hero.h1 }]}>
  <div class="container hero">
    <div class="hero-copy">
      {d.hero.eyebrow && <div class="eyebrow">{d.hero.eyebrow}</div>}
      <h1 class="h1">{d.hero.h1}</h1>
      <p class="hero-lead">{d.hero.lead}</p>
    </div>
  </div>

  <Section borderTop>
    <SectionHeading size="sm" eyebrow={d.forms.eyebrow} title={d.forms.title} />
    <TileGrid>
      {tiles.map((tile) => <ServiceTile {...tile} />)}
      <ServiceCtaTile locale={locale} {...d.forms.cta} />
    </TileGrid>
  </Section>

  <Section tone="surface" gap={32}>
    <SectionHeading eyebrow={d.deliverables.eyebrow} title={d.deliverables.title} />
    <NumberedCards items={d.deliverables.items} min={300} tone="white" />
  </Section>

  <Section layout="split">
    <div class="process-head">
      <div class="eyebrow">{d.process.eyebrow}</div>
      <h2 class="h2-lg">{d.process.title}</h2>
      <p class="muted-16">{d.process.text}</p>
    </div>
    <StepList steps={d.process.steps} resultLabel={d.process.resultLabel} />
  </Section>

  <DarkSection eyebrow={d.security.eyebrow} title={d.security.title} gridGap="28px 32px">
    {d.security.items.map((x) => <RuleItem title={x.title} text={x.text} />)}
  </DarkSection>

  <Section borderTop gap={32}>
    <div class="after-head">
      <div class="after-title">
        <div class="eyebrow">{d.afterPilot.eyebrow}</div>
        <h2 class="h2-lg">{d.afterPilot.title}</h2>
      </div>
      <a href={afterLink} class="after-link">
        {d.afterPilot.link.label}
        <span aria-hidden="true">&nbsp;→</span>
      </a>
    </div>
    <div class="after-grid">
      {
        d.afterPilot.items.map((x) => (
          <div class="after-card">
            <span class="after-label">{x.label}</span>
            <h3 class="after-card-title">{x.title}</h3>
            <p class="after-card-text">{x.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Faq locale={locale} title={faq.title} items={faq.items} borderTop />

  <CtaSection locale={locale} title={d.cta.title} text={d.cta.text} eyebrow={d.cta.eyebrow} buttonLabel={d.cta.button} layout={d.cta.layout} />
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .hero-copy {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero-lead {
    max-width: 760px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .muted-16 {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .process-head {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .after-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 64px;
    align-items: end;
    justify-content: space-between;
  }
  .after-title {
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .after-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    color: var(--royal);
  }
  .after-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .after-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 20px;
    background: var(--surface);
    border-radius: var(--radius-md);
  }
  .after-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--royal);
  }
  .after-card-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
  }
  .after-card-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
