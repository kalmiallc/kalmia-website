---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Prose from '@components/Prose.astro';
import type { LegalEntry } from '@lib/routes';
import type { Locale } from '@lib/i18n';
import { render } from 'astro:content';

interface Props {
  locale: Locale;
  entry: LegalEntry;
}

const { locale, entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={`${d.title} | Kalmia`} description={d.description} breadcrumbs={[{ label: d.h1 }]}>
  <div class="container hero">
    <h1 class="hero-h1">{d.h1}</h1>
  </div>
  <Section borderTop>
    <Prose lang={d.lang && d.lang !== locale ? d.lang : undefined}><Content /></Prose>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--section-y);
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  .hero-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
</style>
