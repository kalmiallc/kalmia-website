---
import BaseLayout from '@layouts/BaseLayout.astro';
import IndexRows from '@components/IndexRows.astro';
import CtaSection from '@components/CtaSection.astro';
import { ui, type Locale } from '@lib/i18n';
import { getPage } from '@lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
// Poziv kot na strani Reference (»Prvi korak«).
const refs = (await getPage(locale, 'reference')).data;
if (refs.template !== 'reference') throw new Error('Napačna predloga.');
---

<BaseLayout locale={locale} title={t.notFound.title} description={t.notFound.description} breadcrumbs={[{ label: '404' }]} noindex>
  <div class="container hero">
    <h1 class="hero-h1">{t.notFound.h1}</h1>
    <p class="hero-lead">{t.notFound.text}</p>
  </div>
  <div class="container index">
    <h2 class="eyebrow kz-head">{t.index.heading}</h2>
    <IndexRows locale={locale} variant="home" />
  </div>
  <CtaSection locale={locale} layout="split" title={refs.cta.title} text={refs.cta.text} />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--section-y);
    padding-bottom: clamp(40px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero-lead {
    max-width: 680px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .index {
    padding-bottom: var(--section-y);
  }
  .kz-head {
    margin: 0;
    padding-bottom: 8.4px;
    border-bottom: 2px solid var(--ink);
  }
</style>
