---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import CaseCard from '@components/CaseCard.astro';
import ClientList from '@components/ClientList.astro';
import NextRow from '@components/NextRow.astro';
import CtaSection from '@components/CtaSection.astro';
import { getCases, pagePath, type PageEntry } from '@lib/content';
import { casePath } from '@lib/routes';
import { indexRows } from '@lib/navigation';
import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  entry: PageEntry;
}

const { locale, entry } = Astro.props;
const d = entry.data;
if (d.template !== 'reference') throw new Error('Napačna predloga.');

const cases = await Promise.all(
  (await getCases(locale, 'reference')).map(async (c) => ({ c, href: await casePath(locale, c.data.slug) }))
);
const nextHref = await pagePath(locale, d.next.page);
const nextTitle = d.next.title ?? indexRows(locale).find((r) => r.key === d.next.page)?.title ?? d.next.page;
---

<BaseLayout locale={locale} title={d.title} description={d.description} breadcrumbs={[{ label: d.breadcrumb ?? d.hero.h1 }]} translationKey={`page:${d.translationKey}`}>
  <div class="container hero">
    {d.hero.eyebrow && <div class="eyebrow">{d.hero.eyebrow}</div>}
    <h1 class="hero-h1">{d.hero.h1}</h1>
    <p class="hero-lead">{d.hero.lead}</p>
  </div>

  <Section tone="surface" gap={28}>
    {
      cases.map(({ c, href }) => (
        <CaseCard
          locale={locale}
          name={c.data.title}
          tag={c.data.tag}
          lead={c.data.lead}
          challenge={c.data.izziv}
          solution={c.data.resitev}
          kpis={c.data.kpis}
          tags={c.data.tags}
          href={href}
        />
      ))
    }
  </Section>

  <div class="container clients">
    <ClientList locale={locale} names={d.clients} variant="stacked" />
  </div>

  <NextRow label={d.next.label} title={nextTitle} href={nextHref} />

  <CtaSection locale={locale} title={d.cta.title} text={d.cta.text} eyebrow={d.cta.eyebrow} buttonLabel={d.cta.button} layout={d.cta.layout} />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-h1 {
    max-width: 960px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero-lead {
    max-width: 680px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .clients {
    padding-top: 48px;
    padding-bottom: 48px;
  }
</style>
