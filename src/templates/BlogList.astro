---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import PostCard from '@components/PostCard.astro';
import CtaSection from '@components/CtaSection.astro';
import { pathForSlug, type PageEntry } from '@lib/content';
import { getPosts, postSlug } from '@lib/routes';
import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  entry: PageEntry;
}

const { locale, entry } = Astro.props;
const d = entry.data;
if (d.template !== 'blog') throw new Error('Napačna predloga.');
const posts = await getPosts(locale);
---

<BaseLayout locale={locale} title={d.title} description={d.description} breadcrumbs={[{ label: d.breadcrumb ?? d.hero.h1 }]} translationKey={`page:${d.translationKey}`}>
  <div class="container hero">
    {d.hero.eyebrow && <div class="eyebrow">{d.hero.eyebrow}</div>}
    <h1 class="hero-h1">{d.hero.h1}</h1>
    <p class="hero-lead">{d.hero.lead}</p>
  </div>

  <Section tone="surface">
    <div class="posts">
      {
        posts.map((p, i) => (
          <PostCard
            locale={locale}
            href={pathForSlug(locale, `${d.slug}/${postSlug(p)}`)}
            title={p.data.title}
            description={p.data.description}
            date={p.data.date}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
            eager={i < 3}
          />
        ))
      }
    </div>
  </Section>

  <CtaSection locale={locale} title={d.cta.title} text={d.cta.text} eyebrow={d.cta.eyebrow} buttonLabel={d.cta.button} layout={d.cta.layout} />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-h1 {
    max-width: 960px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero-lead {
    max-width: 680px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
</style>
