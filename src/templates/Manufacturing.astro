    font-size: 13px;
    line-height: 1.45;
    opacity: 0.8;
  }
  .panels {
    flex: 3 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .panel {
    background: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    scroll-margin-top: 16px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: start;
    justify-content: space-between;
  }
  .panel-intro {
    flex: 1 1 320px;
    min-width: 0;
