    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 13px;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e0742c;
  }
  .badge-note {
    color: var(--support);
  }
  .friction-h {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.25;
  }
  .friction-p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .cases-head {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 64px;
    align-items: end;
    justify-content: space-between;
  }
  .cases-title {
    flex: 1 1 520px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .outline-btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 22px;
    border: 1px solid var(--ink);
    color: var(--ink);
    border-radius: var(--radius-xs);
    font-weight: 600;
    font-size: 15px;
  }
  .cases {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: start;
  }
  .tabs {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tab {
    display: flex;
