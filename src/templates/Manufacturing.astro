    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 0;
    border-top: 1px solid var(--line-dark);
  }
  .stats-v {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.1;
    color: var(--lime);
  }
  .stats-t {
    font-size: 14px;
    line-height: 1.45;
    color: var(--on-dark);
  }

  .friction-title {
    max-width: 820px;
  }
  .friction-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
