    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .systems-label {
    font-size: 13px;
    color: var(--support);
    padding-right: 4px;
  }
  .systems ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
