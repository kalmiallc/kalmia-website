---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import BookingLink from '@components/BookingLink.astro';
import RuleItem from '@components/RuleItem.astro';
import NextRow from '@components/NextRow.astro';
import CtaSection from '@components/CtaSection.astro';
import { getCases, pagePath, type PageEntry } from '@lib/content';
import { indexRows } from '@lib/navigation';
import { isPlaceholder, warnPlaceholder } from '@lib/placeholders';
import { ui, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  entry: PageEntry;
}

const { locale, entry } = Astro.props;
const d = entry.data;
if (d.template !== 'proizvodnja') throw new Error('Napačna predloga.');
const t = ui(locale);

const cases = (await getCases(locale, 'proizvodnja')).map((c) => {
  const where = `referenci "${c.data.title}" (Proizvodnja)`;
  const clean = (list: string[]) => list.filter((x) => (isPlaceholder(x) ? (warnPlaceholder(where, x), false) : true));
  const h = c.data.headline;
  const headline = h && !isPlaceholder(h.v) && !isPlaceholder(h.t) ? h : null;
  if (h && !headline) warnPlaceholder(where, h.v);
  return {
    id: `primer-${c.data.slug}`,
    name: c.data.title,
    tag: c.data.tag,
    tabNote: c.data.inPreparation ? `${c.data.tag} · ${d.cases.inPreparationTab}` : c.data.tag,
    lead: c.data.lead,
    inPreparation: c.data.inPreparation,
    headline,
    challenge: clean(c.data.izziv),
    solution: clean(c.data.resitev),
    results: clean(c.data.rezultati),
    systems: c.data.tags,
  };
});
const referencesHref = await pagePath(locale, 'reference');
const nextHref = await pagePath(locale, d.next.page);
const nextTitle = d.next.title ?? indexRows(locale).find((r) => r.key === d.next.page)?.title ?? d.next.page;
---

<BaseLayout locale={locale} title={d.title} description={d.description} breadcrumbs={[{ label: d.breadcrumb ?? d.hero.h1 }]}>
  <div class="container hero">
    <div class="hero-copy">
      <h1 class="hero-h1">{d.hero.h1}</h1>
      <p class="hero-lead">{d.hero.lead}</p>
      <div class="hero-actions">
        <BookingLink locale={locale} size="royal" />
        <a href={`#${d.cases.id}`} class="hero-cases">{d.hero.casesLink}</a>
      </div>
    </div>
    <div class="stats on-dark">
      <span class="stats-eyebrow">{d.hero.stats.eyebrow}</span>
      {
        d.hero.stats.items.map((s) => (
          <div class="stats-item">
            <span class="stats-v">{s.v}</span>
            <span class="stats-t">{s.t}</span>
          </div>
        ))
      }
    </div>
  </div>

  <Section borderTop gap={40}>
    <h2 class="h2-lg friction-title">{d.friction.title}</h2>
    <div class="friction-grid">
      {
        d.friction.items.map((x) => (
          <div class="friction">
            <div class="badge">
              <span class="badge-dot" aria-hidden="true" />
              <strong>{x.badge}</strong>
              <span class="badge-note">· {x.badgeNote}</span>
            </div>
            <h3 class="friction-h">{x.title}</h3>
            <p class="friction-p">{x.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id={d.cases.id} tone="surface" gap={40}>
    <div class="cases-head">
      <div class="cases-title">
        <div class="eyebrow">{d.cases.eyebrow}</div>
        <h2 class="h2-lg">{d.cases.title}</h2>
      </div>
      <a href={referencesHref} class="outline-btn">
        {d.cases.allLink}
        <span aria-hidden="true">&nbsp;→</span>
      </a>
    </div>
    <div class="cases" data-tabs>
      <ul class="tabs" data-tablist aria-label={d.cases.eyebrow}>
        {
          cases.map((c, i) => (
            <li>
              <a href={`#${c.id}`} class:list={['tab', { 'tab--on': i === 0 }]} data-tab={c.id}>
                <span class="tab-name">{c.name}</span>
                <span class="tab-note">{c.tabNote}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="panels">
        {
          cases.map((c) => (
            <article class="panel" id={c.id} data-panel>
              <div class="panel-head">
                <div class="panel-intro">
                  <span class="panel-tag">{c.tag}</span>
                  <h3 class="panel-name">{c.name}</h3>
                  <p class="panel-lead">{c.lead}</p>
                </div>
                {c.headline && (
                  <div class="panel-kpi on-dark">
                    <span class="panel-kpi-v">{c.headline.v}</span>
                    <span class="panel-kpi-t">{c.headline.t}</span>
                  </div>
                )}
              </div>
              {c.inPreparation && <p class="panel-note">{d.cases.inPreparationNote}</p>}
              <div class="panel-grid">
                {c.challenge.length > 0 && (
                  <div class="pbox">
                    <h4 class="pbox-label">{t.cases.challenge}</h4>
                    <ul>
                      {c.challenge.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {c.solution.length > 0 && (
                  <div class="pbox">
                    <h4 class="pbox-label pbox-label--royal">{t.cases.solution}</h4>
                    <ul>
                      {c.solution.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {c.results.length > 0 && (
                  <div class="pbox pbox--lime">
                    <h4 class="pbox-label pbox-label--ink">{t.cases.result}</h4>
                    <ul>
                      {c.results.map((x) => (
                        <li class="pbox-result">✓ {x}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              {c.systems.length > 0 && (
                <div class="systems">
                  <span class="systems-label">{d.cases.systemsLabel}</span>
                  <ul>
                    {c.systems.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section gap={40}>
    <div class="sol-head">
      <div class="sol-title">
        <div class="eyebrow">{d.solutions.eyebrow}</div>
        <h2 class="h2-lg">{d.solutions.title}</h2>
      </div>
      <p class="sol-text">{d.solutions.text}</p>
    </div>
    <div class="sol-grid">
      {
        d.solutions.items.map((x) => (
          <div class="sol">
            <h3 class="sol-h">{x.title}</h3>
            <p class="sol-p">{x.text}</p>
            <p class="sol-benefit">
              <span aria-hidden="true" class="sol-check">
                ✓
              </span>{' '}
              {x.benefit}
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="dark" layout="split" class="product">
    <div class="product-head">
      <div class="eyebrow product-eyebrow">{d.product.eyebrow}</div>
      <h2 class="h2-lg product-title">{d.product.title}</h2>
      <p class="product-text">{d.product.text}</p>
    </div>
    <div class="product-grid">
      {
        d.product.items.map((x) => (
          <div class="product-item">
            <h3 class="product-h">{x.title}</h3>
            <p class="product-p">{x.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section borderTop layout="split">
    <div class="start-head">
      <div class="eyebrow">{d.start.eyebrow}</div>
      <h2 class="h2-lg">{d.start.title}</h2>
    </div>
    <div class="start-grid">
      {d.start.items.map((x) => <RuleItem tone="light" title={x.title} text={x.text} titleSize={19} />)}
    </div>
  </Section>

  <NextRow label={d.next.label} title={nextTitle} href={nextHref} />

  <CtaSection locale={locale} title={d.cta.title} text={d.cta.text} eyebrow={d.cta.eyebrow} buttonLabel={d.cta.button} layout={d.cta.layout} />
</BaseLayout>

<script>
  // Zavihki z referencami. Brez JavaScripta so vse reference prikazane ena pod drugo.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!list || !tabs.length) continue;
    root.classList.add('cases--js');
    list.setAttribute('role', 'tablist');
    list.querySelectorAll('li').forEach((li) => li.setAttribute('role', 'presentation'));

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        tab.classList.toggle('tab--on', on);
        panels[i]?.toggleAttribute('hidden', !on);
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', tab.dataset.tab ?? '');
      tab.id = `${tab.dataset.tab}-tab`;
      panels[i]?.setAttribute('role', 'tabpanel');
      panels[i]?.setAttribute('aria-labelledby', tab.id);
      panels[i]?.setAttribute('tabindex', '0');
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        select(i);
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
        if (e.key in keys) {
          e.preventDefault();
          select((i + keys[e.key]! + tabs.length) % tabs.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          select(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
    select(0);
  }
</script>

<style>
  .hero {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: center;
  }
  .hero-copy {
    flex: 2 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
